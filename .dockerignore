# Keep the build context small and the image free of local state. In
# particular .git is excluded, but the commit is still recorded: the Dockerfile
# reads it out of a build arg supplied by compose, so experiment manifests can
# cite a real commit without shipping the repository history.
.git
.gitignore
.venv
venv
node_modules
frontend/node_modules
frontend/dist
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage
*.db
*.sqlite3
*.log
results/*.log
results/reproducibility
.env
.env.local
*.pem
*.key
.DS_Store
Thumbs.db
docs/report.pdf
tests/__pycache__
