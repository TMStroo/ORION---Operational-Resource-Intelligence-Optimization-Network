# ORION configuration. Copy to .env and adjust. Never commit real secrets.
ORION_ENV=development
ORION_LOG_LEVEL=INFO
ORION_LOG_FORMAT=json

# Persistence. ORION runs fully on SQLite by default so a clean checkout works
# with zero external services. Set ORION_DATABASE_URL to use PostgreSQL.
ORION_DATABASE_URL=sqlite:///orion.db
# postgresql+psycopg2://orion:orion@localhost:5432/orion

# API
ORION_API_HOST=127.0.0.1
ORION_API_PORT=8000
ORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Experiment store
ORION_EXPERIMENTS_DIR=experiments
ORION_RESULTS_DIR=results
